# SuperDocs API Key (never commit real keys)
SUPERDOCS_API_KEY=your-key-here
SUPERDOCS_BASE_URL=https://api.superdocs.app

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bates_packet

# File Storage
STORAGE_ROOT=./storage
ORIGINALS_DIR=originals
PROCESSED_DIR=processed
WORKING_DIR=working
FINAL_DIR=final

# OCR
TESSERACT_CMD=tesseract
TESSERACT_LANG=eng

# Bates Configuration
BATES_PREFIX=CASE-
BATES_START_NUMBER=1
BATES_PADDING=6

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO