{
  "version": "1.0",
  "description": "Court rule profiles for Bates stamping and exhibit formatting. Changing courts or formatting rules is a data change, not a code rewrite.",
  "default_profile": "SDNY_FEDERAL",
  "profiles": {
    "SDNY_FEDERAL": {
      "name": "Southern District of New York (Federal)",
      "prefix_format": "CASE-{number:06d}",
      "prefix_example": "CASE-000001",
      "stamp_position": {
        "horizontal": "right",
        "vertical": "bottom",
        "margin_x": 160,
        "margin_y": 30
      },
      "font": {
        "name": "helv",
        "size": 10,
        "color": [0, 0, 0]
      },
      "confidentiality_stamp": {
        "enabled": true,
        "text": "CONFIDENTIAL - SUBJECT TO PROTECTIVE ORDER",
        "position": {
          "horizontal": "center",
          "vertical": "top",
          "margin_x": 0,
          "margin_y": 50
        },
        "font": {
          "name": "helv",
          "size": 12,
          "color": [1, 0, 0],
          "bold": true
        },
        "opacity": 0.3
      },
      "cover_sheet": {
        "include_bates_range": true,
        "include_page_count": true,
        "include_privilege_status": true,
        "include_description": true
      },
      "exhibit_index": {
        "format": "EXHIBIT {letter}",
        "columns": ["exhibit", "bates_range", "description", "pages"]
      },
      "privilege_log": {
        "include_category": true,
        "include_reason": true
      },
      "page_size": [612, 792],
      "margins": [54, 54, 54, 54]
    },
