# Public HTTPS address of this service. Twilio must be able to POST to it and
# the SMS recipient must be able to open its /files links.
PUBLIC_BASE_URL=https://your-public-host.example
PORT=3000

# SuperDocs REST API
SUPERDOCS_API_KEY=your-superdocs-api-key
SUPERDOCS_BASE_URL=https://api.superdocs.app

# Twilio credentials and the SMS-capable number you own.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=twilio-phone-number

# Keep true in production. Set false only for a local test without Twilio.
TWILIO_VALIDATE_SIGNATURES=true
MAX_DOCUMENT_BYTES=10485760
LOG_MESSAGE_BODY=true
