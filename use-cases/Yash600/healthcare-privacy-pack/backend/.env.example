# Get a free key: POST https://api.superdocs.app/v1/agents/signup
# {"terms_accepted": true, "agent_name": "your-agent-name"}
# 500 free operations/month, no human approval step. Exports and reads
# (GET /v1/documents/{id}) are never billed -- only chat/chat-async edits.
SUPERDOCS_API_KEY=sk_your_key_here
SUPERDOCS_API_BASE=https://api.superdocs.app

# Required for POST /workspaces/{id}/analyze (Analyze References) -- the one
# phase of the system that calls an LLM directly instead of SuperDocs (see
# llm_client.py for why). Free key at https://console.groq.com/keys.
# Everything else in the app works without this set; only Analyze
# References needs it.
GROQ_API_KEY=gsk_your_key_here

# Optional: which Groq-hosted model runs Analyze References. Defaults to
# openai/gpt-oss-120b if unset (see llm_client.py's DEFAULT_MODEL) -- only
# set this if you want a different model. Must support tool/function
# calling, since discovery relies on forced structured tool-call output,
# not prompted JSON.
# GROQ_MODEL=openai/gpt-oss-120b

# Primary path: a real Neon Postgres database. Create a project at
# https://console.neon.tech, copy the connection string it gives you
# (already includes ?sslmode=require -- keep that), uncomment the line
# below, and paste it in. db.py connects to it exactly like any other
# Postgres server -- nothing Neon-specific in the code, it's a plain
# SQLAlchemy/psycopg2 URL.
# DATABASE_URL=postgresql://<user>:<password>@<your-project>.neon.tech/<dbname>?sslmode=require

# Fallback (no setup required, this is the default): with DATABASE_URL left
# unset/commented-out as above, db.py automatically uses an embedded
# Postgres instead (via the `pgserver` package) -- real PostgreSQL 16, zero
# Docker, zero root, data stored under ~/.healthcare_compliance_workspace/pgdata.
# Handy for a quick local run without a Neon project set up yet. Once you
# set a real DATABASE_URL above, this fallback is skipped entirely.

# Optional: override where the embedded Postgres data directory lives
# (only used when the fallback above is active). Keep this OUTSIDE any
# network-mounted or synced folder -- Postgres needs real POSIX file
# locking for its data directory.
# PGDATA_DIR=/some/local/path/pgdata
