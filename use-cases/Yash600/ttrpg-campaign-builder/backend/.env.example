# Get a free key: POST https://api.superdocs.app/v1/agents/signup
# {"terms_accepted": true, "agent_name": "your-agent-name"}
# 500 free operations/month, no human approval step. Exports and reads
# (GET /v1/documents/{id}) are never billed -- only chat/chat-async edits.
# You can reuse the same key/account as the healthcare-privacy-pack build --
# SuperDocs organizes by durable document, not by which local app called it.
SUPERDOCS_API_KEY=sk_your_key_here
SUPERDOCS_API_BASE=https://api.superdocs.app

# Local dev default: leave as-is. db.py detects this exact placeholder value
# and falls back to an embedded Postgres (via the `pgserver` package)
# instead -- real PostgreSQL 16, zero Docker, zero root, data stored under
# ~/.shattered_crown_campaigns/pgdata. Fine for running on your laptop, not
# for a deployed backend (Render's web-service disk isn't guaranteed to
# persist across deploys/restarts).
#
# For deployment: point this at a real external Postgres URL instead --
# db.py connects to any of these identically, nothing provider-specific in
# the code. Two options that need zero server-ops:
#   1. Neon (same approach as the healthcare-privacy-pack build -- you can
#      reuse that Neon account and just create a second project here):
#      create a project at https://console.neon.tech, paste its connection
#      string below (keep the ?sslmode=require it gives you).
#   2. Render's own managed Postgres, via this project's render.yaml (New ->
#      Blueprint in the Render dashboard provisions it automatically and
#      wires DATABASE_URL for you -- no manual copy-paste needed). Only
#      caveat: Render's *free* Postgres plan expires 30 days after creation
#      (14-day grace period to upgrade before deletion) -- fine for a demo,
#      but if this needs to stay up past a month, either upgrade that
#      database to a paid plan or switch to option 1 (Neon has no such
#      free-tier expiry as of this writing).
DATABASE_URL=postgresql://superdocs:superdocs@localhost:5432/shattered_crown
# DATABASE_URL=postgresql://<user>:<password>@<your-project>.neon.tech/<dbname>?sslmode=require

# Optional: override where the embedded Postgres data directory lives.
# Keep this OUTSIDE any network-mounted or synced folder -- Postgres needs
# real POSIX file locking for its data directory.
# PGDATA_DIR=/some/local/path/pgdata

# Illustration generation: image.pollinations.ai is free and keyless, no
# variable needed here. If you'd rather point at a different keyless/':bring
# your own key' image endpoint, see image_gen.py -- it's a single function.

# Every generated/uploaded illustration is also saved locally under
# ./illustration_assets and served at PUBLIC_BACKEND_BASE + /static/... --
# this is what the in-app gallery actually displays, since SuperDocs'
# upload-base64 endpoint has been observed returning storage.googleapis.com
# URLs whose object ACL isn't actually public (anonymous fetch = 403
# AccessDenied), a platform-side issue on SuperDocs' end. Only change this
# if the backend isn't reachable at localhost:8001 from your browser (e.g.
# a different port, or a deployed backend behind a real domain).
PUBLIC_BACKEND_BASE=http://localhost:8001
