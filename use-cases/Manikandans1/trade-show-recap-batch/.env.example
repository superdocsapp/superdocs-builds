# No /v1 suffix — the client builds full paths itself.
SUPERDOCS_BASE_URL=https://api.superdocs.app
SUPERDOCS_API_KEY=
EXPORT_FORMAT=pdf
SUPERDOCS_MODEL_TIER=
SUPERDOCS_THINKING_DEPTH=

# "ask_every_time" (default) exercises the full documented four-endpoint
# contract (upload, chat/async, approve, export) with every change
# auto-approved by the batch runner. "approve_all" folds edit+approve
# into one synchronous /v1/chat call. See README for the full reasoning.
SUPERDOCS_APPROVAL_MODE=ask_every_time

SUPERDOCS_POLL_INTERVAL_SECONDS=2.0
SUPERDOCS_MAX_WAIT_SECONDS=300.0
SUPERDOCS_MAX_RETRIES=5
SUPERDOCS_RETRY_BASE_DELAY_SECONDS=1.0
SUPERDOCS_REQUEST_TIMEOUT_SECONDS=60.0

# "Budget your operations" — leave blank/unset to process every lead in
# the CSV, or set a small number (e.g. 2) while testing against a live
# free-tier key. --limit on the CLI overrides this per-run.
MAX_LEADS_PER_RUN=
