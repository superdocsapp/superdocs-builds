# ==============================================================================
# DOCINTEL PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your configuration values.
# NEVER commit your actual .env file or real secrets to version control.

# Database Configuration (PostgreSQL 14+ with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docintel

# Authentication & Security
SECRET_KEY=change-me-to-a-secure-random-32-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
STREAM_TOKEN_EXPIRE_SECONDS=60
SECURE_COOKIES=false

# AI & LLM Providers
# Primary LLM provider selection: "gemini", "groq", or "cerebras"
LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Groq Configuration (Alternative LLM provider)
GROQ_API_KEY=your-groq-api-key-here

# Cerebras Configuration (Alternative LLM provider)
CEREBRAS_API_KEY=your-cerebras-api-key-here

# Embeddings & Vector Search
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# SuperDocs Document Intelligence & Collaboration Integration
SUPERDOCS_API_KEY=your-superdocs-api-key-here
SUPERDOCS_API_URL=https://api.superdocs.app

# Storage & Runtime Paths
STORAGE_PATH=./storage

# Application Server & Logging
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
