# VocDigest configuration. Copy to .env and fill in the two API keys.
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys. The application never logs a key, even
# partially, and /health/ready reports only whether each key is set.

# ---------------------------------------------------------------- required

# SuperDocs API key. Get one at https://superdocs.app
# Only needed for the final publish stage — every other stage runs without it, and the
# entire test suite runs without it.
SUPERDOCS_API_KEY=

# Groq API key (free tier is sufficient). Get one at https://console.groq.com
GROQ_API_KEY=

# ---------------------------------------------------------------- SuperDocs

SUPERDOCS_BASE_URL=https://api.superdocs.app
# How long to poll one edit before pausing the run. A timeout is treated as "probably
# still running server-side", not as a crash. The API caps a turn at 30 minutes.
SUPERDOCS_POLL_TIMEOUT_S=900
SUPERDOCS_POLL_INITIAL_S=2.0
SUPERDOCS_POLL_MAX_S=15.0
SUPERDOCS_CONNECT_TIMEOUT_S=30.0
# core | turbo | pro | max — pro is recommended for documents that go to executives.
SUPERDOCS_MODEL_TIER=pro
# fast | balanced | deep
SUPERDOCS_THINKING_DEPTH=balanced

# ---------------------------------------------------------------- Groq

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# Must stay 0 for idempotency: the same input has to produce the same output, or a
# resumed run silently diverges from the run it is continuing.
GROQ_TEMPERATURE=0.0
GROQ_TIMEOUT_S=120.0
# Used only for the cost report. Wrong values mis-report spend, nothing else.
GROQ_INPUT_COST_PER_MTOK=0.59
GROQ_OUTPUT_COST_PER_MTOK=0.79

# ---------------------------------------------------------------- database

DATABASE_URL=postgresql+asyncpg://vocdigest:vocdigest@localhost:5432/vocdigest
DB_ECHO=false

# Create tables at startup instead of running Alembic. For the demo and tests only —
# in a real deployment Alembic owns the schema and this would mask a missed migration.
AUTO_CREATE_TABLES=false

# ---------------------------------------------------------------- embeddings

# local = sentence-transformers (needs the optional install, real semantic clustering)
# hash  = deterministic offline stand-in, no download, weaker clustering
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match the model's output width. Changing this needs a new migration, because the
# pgvector column width is fixed at migration time.
EMBEDDING_DIM=384

# ---------------------------------------------------------------- run behaviour

NODE_MAX_RETRIES=3
NODE_RETRY_BASE_DELAY_S=1.0
MAX_CONVERSATION_CHARS=8000
LLM_BATCH_SIZE=20
# Cosine similarity above which two conversations join the same theme. Tuned for
# MiniLM. If EMBEDDING_BACKEND=hash, lower this to ~0.35 or everything fragments.
CLUSTER_THRESHOLD=0.62

# ---------------------------------------------------------------- server

API_HOST=0.0.0.0
API_PORT=8000
MCP_PORT=8001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
DATA_DIR=./data

# ---------------------------------------------------------------- checkpoint mirror

# Optional. Write-behind SQLite copy of every checkpoint (aiosqlite), so run state
# survives losing Postgres and can be inspected with the sqlite3 CLI. Postgres stays
# authoritative — a mirror failure is logged and never fails a run. Empty = disabled.
# CHECKPOINT_SQLITE_PATH=./data/checkpoints.db

# ---------------------------------------------------------------- fallbacks

# When Groq is missing, down, or out of credits, fall back to keyword heuristics rather
# than pausing. Quality drops materially and the digest says so in its methodology
# section. Set false to pause and wait for the key instead.
ALLOW_DEGRADED_ANALYSIS=true

# When SuperDocs is missing, rejected, unreachable or out of quota, render the digest
# locally instead of stranding a completed analysis. Set false to pause instead.
ALLOW_LOCAL_RENDER=true
