# Copy to .env (which is gitignored) and fill in.
#
# Get a key either way:
#   1. Sign in at https://use.superdocs.app -> Settings -> API keys
#   2. Or let your agent sign itself up (the account belongs to you):
#        curl -X POST https://api.superdocs.app/v1/agents/signup \
#          -H 'Content-Type: application/json' \
#          -d '{"terms_accepted": true, "agent_name": "your-agent-name"}'
#
SUPERDOCS_API_KEY=your-key-here
SUPERDOCS_BASE_URL=https://api.superdocs.app
