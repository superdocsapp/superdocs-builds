# Copy this file to .env and set the server-side MCP key in backend/.env.
# Never expose SUPERDOCS_MCP_API_KEY through VITE_* variables or frontend code.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-server-side-secret
