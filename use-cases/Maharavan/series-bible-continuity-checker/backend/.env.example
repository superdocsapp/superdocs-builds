ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://series_bible:series_bible@localhost:5432/series_bible
ALLOWED_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_BYTES=26214400
SUPERDOCS_MCP_URL=https://api.superdocs.app/mcp
SUPERDOCS_MCP_API_KEY=replace-with-server-side-key
SUPERDOCS_MCP_TIMEOUT_SECONDS=60
SUPERDOCS_JOB_POLL_SECONDS=1
SUPERDOCS_JOB_TIMEOUT_SECONDS=90

# grounded_rules is local and deterministic. Use openai_compatible for production LLM extraction.
EXTRACTION_PROVIDER=grounded_rules
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-only-when-using-openai-compatible
LLM_MODEL=gpt-4.1-mini

# Optional bearer protection for all /api/v1 routes. Health endpoints remain public.
API_AUTH_TOKEN=replace-with-a-long-random-production-token

# Google authentication is supplied from the project-level .env used by Compose.
# GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# JWT_SECRET=replace-with-a-long-random-server-side-secret