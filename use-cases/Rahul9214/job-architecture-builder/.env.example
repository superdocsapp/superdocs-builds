SUPERDOCS_API_KEY=your-key-here
SUPERDOCS_BASE_URL=https://api.superdocs.app
REQUEST_TIMEOUT_SECONDS=120

# Server-side only. Never put the API key in frontend code, fixtures, or logs.
# Offline pytest does not read this file and does not call SuperDocs.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DEMO_MODE=true
MAX_ROLES=6