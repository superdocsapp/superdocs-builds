SUPERDOCS_API_KEY=your-key-here
SUPERDOCS_MCP_URL=https://api.superdocs.app/mcp/
# Live API: 4-section batches can silently no-op; 2 lands. Config, not a hardcoded hunt.
SUPERDOCS_CHAT_BATCH_CAP=2
# Small-sample / stop rule: abort when charged ops exceed this ceiling.
# Four-vertical ledger is already 39 ops; use ≥200 for docker compose / image work.
OPS_BUDGET_CAP=200
# Cursor MCP: copy .cursor/mcp.json.example → .cursor/mcp.json with the same sk_
# key. mcp.json is gitignored — never commit a real Bearer token.
