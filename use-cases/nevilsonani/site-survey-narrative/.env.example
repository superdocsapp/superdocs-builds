# SuperDocs API key (sk_...). Get one at use.superdocs.app -> Settings -> API Keys,
# or let your coding agent self-signup: docs.superdocs.app/introduction/agent-signup
SUPERDOCS_API_KEY=

# Hard stop for spend: the app refuses to start an operation that would
# exceed this many billable ops in one run.
S2N_OP_BUDGET=25
