# Required by the backend. Use the async SQLAlchemy PostgreSQL driver.
DATABASE_URL=postgresql+asyncpg://docrelay:docrelay@localhost:5432/docrelay

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Phase 3 production SuperDocs adapter. Keep this server-side only.
SUPERDOCS_API_KEY=your-superdocs-api-key
SUPERDOCS_API_BASE=https://api.superdocs.app/v1
SUPERDOCS_HTTP_TIMEOUT_SECONDS=60
PHASE3_WORKER_POLL_SECONDS=2
DOCRELAY_ARTIFACT_DIR=.docrelay-artifacts

# Phase 2 Google OAuth is optional at process startup, but these four values must be
# set together when enabled. Generate the Fernet keyring as described in README.md.
# Never commit real client secrets or encryption keys.
# GOOGLE_OAUTH_CLIENT_ID=your-web-application-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-web-application-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/google/oauth/callback
# OAUTH_TOKEN_ENCRYPTION_KEYS={"v1":"generated-fernet-key"}
OAUTH_TOKEN_ENCRYPTION_PRIMARY_VERSION=v1

# DocRelay does not yet have application-user authentication. This value is the
# stable local application-owner subject, not a Google email or OAuth subject.
DOCRELAY_OWNER_SUBJECT=local-development-owner

# Browser-visible backend origin used by the frontend.
NEXT_PUBLIC_DOCRELAY_API_URL=http://localhost:8000

# Phase 2.5 frontend Google Picker configuration (all public/browser-safe).
# These are read by Next.js from frontend/.env.local at build/dev time.
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-web-application-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=your-browser-api-key
# NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
