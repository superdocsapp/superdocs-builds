# DocRelay frontend environment — Phase 2.5 Google Picker
#
# Copy this file to frontend/.env.local and fill in real values.
# .env.local is gitignored by Next.js conventions.
#
# All values here are browser-safe public configuration.
# NEVER put secrets (client_secret, encryption keys, tokens) in this file.

# Backend API origin
NEXT_PUBLIC_DOCRELAY_API_URL=http://localhost:8000

# Same OAuth client ID used by the backend (Web application type)
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Browser API key restricted to Google Picker API
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=AIzaSy...

# Google Cloud project NUMBER (not name/ID), found in project settings
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
