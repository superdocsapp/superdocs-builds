# cp .env.example .env  --  and the build runs. No signup, no key of your own.
#
# These two point at a shared relay that holds the SuperDocs key and lends it
# under a ration. The key below is NOT a secret: it is meant to be committed,
# it is the same key for everyone, and the ration is shared with everyone using
# it. Budgets reset at 00:00 UTC.
#
#   460   SuperDocs operations per key per day
#          -- charged for /v1/chat and /v1/chat/async and re-edits ONLY.
#             Uploads, exports, job polls and whoami are free, which is exactly
#             the set of calls this build already treats as free.
#    60   requests per minute per key   (90 per minute per IP)
#     8   MB maximum request body

RELAY_URL=https://relay.pxyz943.workers.dev
RELAY_KEY=pk_f2a01b7f189f0d1ea6c57a04cb83c14e

# To use your own SuperDocs key instead, uncomment this. It then takes
# precedence over everything above, the calls go straight to api.superdocs.app,
# and the key never reaches the relay -- no ration, and nobody else's logs.
# The agent stops reporting a second ceiling because there is not one.
#
# SUPERDOCS_API_KEY=sk_your_key_here

# Only if you are pointing at something other than the origin -- a staging
# deployment, or a proxy of your own. Ignored unless SUPERDOCS_API_KEY is set.
#
# SUPERDOCS_BASE_URL=https://api.superdocs.app

# Where the operation ledger lives. It is what stops a rerun after a crash
# paying twice for an edit already in the document, so it must outlive the
# process -- and it must NOT be shared between two accounts.
#
# QUOTA_AWARE_AGENT_LEDGER=~/.quota-aware-agent/operations.jsonl
