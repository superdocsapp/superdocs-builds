# ─────────────────────────────────────────────────────────────────────────────
#  Split-a-Document — standalone. No analyst, no Postgres, no Office host.
#
#      cp .env.example .env
#      docker compose up          # → http://localhost:8080
#
#  Separate from the repo-root .env.example for the same reason as the
#  redaction pane: this app does not import doctask-core and must run from a
#  `cp -r` into someone else's repository.
# ─────────────────────────────────────────────────────────────────────────────

# --- Required --------------------------------------------------------------
SUPERDOCS_API_KEY=

# --- SuperDocs -------------------------------------------------------------
SUPERDOCS_BASE_URL=https://api.superdocs.app
SD_TIMEOUT_S=120

# --- Serving ---------------------------------------------------------------
# Plain HTTP is fine here — this is an ordinary web tool, not an Office add-in.
PORT=8080

# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:////data/splitter.db

# --- Behaviour -------------------------------------------------------------
# Splitting is stateless HTML slicing plus one export per part — there is no
# split endpoint, and none is needed. Each export costs 1 op.
MAX_PARTS=10
# Refuse to return outputs whose block counts do not sum to the original.
VERIFY_COVERAGE=true
