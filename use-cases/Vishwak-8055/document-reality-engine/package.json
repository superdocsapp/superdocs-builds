{
  "name": "superdocs-document-reality-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SuperDocs Document Reality Engine — a document operating system that models what a document claims, what evidence supports it, what rules govern it, and what should happen next.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
