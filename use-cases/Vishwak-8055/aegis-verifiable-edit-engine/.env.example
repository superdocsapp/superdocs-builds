# Copy to .env and fill in for real (non-mock) usage. Never commit the real .env file.

# ---- Execution mode ----
# "mock" (default) runs Aegis against the deterministic in-memory SuperDoc client
# in src/execution/mockSuperDocClient.ts. Nothing here needs credentials.
# "live" would route through a real SuperDoc Document API client (see
# src/execution/superDocClient.ts and docs/ARCHITECTURE.md "Known limitations" —
# a live client is not implemented in this repository yet).
AEGIS_MODE=mock

# ---- SuperDoc (only used when AEGIS_MODE=live) ----
# SuperDoc is self-hosted / client-side by design (see https://docs.superdoc.dev),
# so there is no SaaS API key. A live client would instead need the location of the
# host process it talks to, e.g. a headless Node runner or an internal automation
# service that embeds @superdoc-dev packages.
SUPERDOC_HOST_URL=
SUPERDOC_HOST_TOKEN=

# ---- Optional AI provider (only used for the pluggable semantic-ambiguity hook) ----
# Aegis's deterministic verifiers do NOT require this. It is only consulted by
# src/intent/aiProvider.ts for genuinely ambiguous semantic comparisons, and the
# system runs correctly (falling back to deterministic-only judgments) without it.
AI_PROVIDER=none
ANTHROPIC_API_KEY=

# ---- Policy / operational tuning ----
AEGIS_RETRY_BUDGET=2
AEGIS_TIMEOUT_MS=10000
AEGIS_LOG_LEVEL=info
AEGIS_LOG_DOCUMENT_CONTENT=false
