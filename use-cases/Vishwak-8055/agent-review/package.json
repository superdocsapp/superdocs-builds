{
  "name": "superdocs-agent-review",
  "displayName": "SuperDocs Agent Review",
  "description": "Reviewable, attributable document changes for any coding agent using SuperDocs — before/after, approve/reject/revert per change, claimed-vs-actual audit trail.",
  "version": "0.1.0",
  "private": true,
  "publisher": "replace-with-your-publisher-id",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/superdocsapp/superdocs-builds.git",
    "directory": "extensions/replace-with-your-publisher-id/superdocs-agent-review"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test --ext .ts",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --sourcemap"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "superdocsAgentReview",
          "title": "SuperDocs Review",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "superdocsAgentReview": [
        {
          "id": "superdocsAgentReview.turns",
          "name": "Turns"
        }
      ]
    },
    "commands": [
      {
        "command": "superdocsAgentReview.connect",
        "title": "SuperDocs Review: Connect Account"
      },
      {
        "command": "superdocsAgentReview.disconnect",
        "title": "SuperDocs Review: Disconnect Account"
      },
      {
        "command": "superdocsAgentReview.refresh",
        "title": "SuperDocs Review: Refresh"
      },
      {
        "command": "superdocsAgentReview.openPanel",
        "title": "SuperDocs Review: Open Review Panel"
      }
    ]
  },
  "dependencies": {
    "sanitize-html": "^2.17.7"
  }
}
