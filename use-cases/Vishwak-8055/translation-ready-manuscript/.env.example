# Copy to .env and fill in locally. Never commit the real .env file.
# The application loads .env on server startup without exposing it to the browser.

# Optional: richer semantic term/style extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: live SuperDocs verification from the server-side adapter.
SUPERDOCS_API_KEY=
# Optional SuperDocs request tuning: core | turbo | pro | max
SUPERDOCS_MODEL_TIER=pro
# Optional SuperDocs thinking depth: fast | balanced | deep
SUPERDOCS_THINKING_DEPTH=balanced

# Optional local server port.
PORT=8787
