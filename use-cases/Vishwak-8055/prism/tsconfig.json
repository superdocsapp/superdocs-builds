{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["packages/*/src/**/*.js", "packages/*/*.js", "cli.js"],
  "exclude": ["**/node_modules/**", "**/test/**", "**/public/**", "**/fixtures/**"]
}
