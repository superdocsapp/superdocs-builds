# Copy to .env for local dev (never commit the real .env).

# Real SuperDocs API key. Rotate immediately if it's ever pasted into
# chat, a commit, or a log.
SUPERDOCS_API_KEY=sk_replace_me

# Comma-separated key:staff_name:role triples. Roles: preparer, approver,
# admin. A preparer can draft; only approver/admin can approve+export, and
# never their own draft (separation of duties enforced in service.py).
# Generate keys with a real secrets generator, not by hand:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
STAFF_API_KEYS=sk_local_prep:Dev Preparer:preparer,sk_local_appr:Dev Approver:approver

# SQLite by default; Postgres in production (Render injects this).
DATABASE_URL=sqlite:///./case_status_desk.db

LOG_LEVEL=INFO

# --- Rate limiting (in-process; see rate_limit.py for the single-instance caveat) ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- SSO (optional; leave both blank to keep using STAFF_API_KEYS above) ---
# Setting these switches auth.require_staff_user over to real OIDC token
# verification (sso.py) instead of the shared-key allowlist. Values below
# are EXAMPLES for Okta -- replace with your actual IdP's issuer/audience.
# OIDC_ISSUER=https://your-org.okta.com/oauth2/default
# OIDC_AUDIENCE=api://case-status-desk
# OIDC_ROLE_CLAIM=groups
# OIDC_ROLE_MAP=Immigration-Paralegals:preparer,Immigration-Attorneys:approver

