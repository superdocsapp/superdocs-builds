# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file to version control.

# SuperDocs Authentication
SUPERDOCS_API_KEY=your_api_key_here

# MCP Endpoint (Server-Sent Events)
SUPERDOCS_MCP_URL=https://api.superdocs.app/mcp/sse

# REST Base URL (for REST pipeline in main.py)
SUPERDOCS_BASE_URL=https://docs.superdocs.app/api

# Budgeting & Loop Controls (Prevents burning API limits during debugging)
SMALL_SAMPLE_MODE=true
MAX_TOOL_CALLS=5
MAX_OPERATIONS=5

# Polling & Timeout configuration
POLL_INTERVAL_SECONDS=5
MAX_POLL_MINUTES=10
