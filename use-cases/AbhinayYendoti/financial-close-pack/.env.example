# ---------------------------------------------------------------------------
# Frontend (Vite). Only VITE_* variables reach the browser bundle.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_DEV_PORT=5180

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# Origin allowed by CORS. Must match where the frontend is actually served.
FRONTEND_ORIGIN=http://localhost:5180
# Optional extra origins, comma separated (e.g. a Vercel preview domain).
ADDITIONAL_CORS_ORIGINS=

# HMAC key for session tokens. Leave blank locally and one is generated under
# STORAGE_DIR. Set an explicit value in production so tokens survive redeploys.
SESSION_SECRET=

# Persistence. sqlite:// URLs only - see "Not yet integrated" in the README.
DATABASE_URL=sqlite:///./var/close_pack.db
# Uploaded documents and exported packs are written here.
STORAGE_DIR=./var/storage

# SuperDocs. "mock" runs fully offline; "live" requires SUPERDOCS_API_KEY.
SUPERDOCS_MODE=mock
SUPERDOCS_API_KEY=
SUPERDOCS_BASE_URL=https://api.superdocs.com

# ---------------------------------------------------------------------------
# Clerk (optional). With a secret key set, Clerk becomes the only accepted
# issuer and POST /auth/demo-session returns 403. The JWKS URL and issuer are
# decoded from the publishable key, so no extra variable is needed.
# The frontend reads VITE_CLERK_PUBLISHABLE_KEY from frontend/.env, not here.
# ---------------------------------------------------------------------------
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL (optional). Takes precedence over DATABASE_URL, so the sqlite
# default above can stay untouched. Blank falls back to sqlite.
# ---------------------------------------------------------------------------
NEON_DATABASE_URL=

# ---------------------------------------------------------------------------
# S3-compatible object storage (optional). Storj, Cloudflare R2 and AWS all
# work through the same client. All three of endpoint, key id and bucket must
# be set or uploads fall back to STORAGE_DIR on local disk.
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-1
