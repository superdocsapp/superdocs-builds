# ---------------------------------------------------------------- SuperDocs
# SuperDocs is a live integration. Without a key the workflow refuses to run;
# there is no hand-written mock and no offline fallback.
SUPERDOCS_API_KEY=
SUPERDOCS_BASE_URL=https://api.superdocs.app

# Record/replay transport. "off" (default) always calls the live API.
#   record  call the live API and save every response to server/cassettes
#   replay  serve those recorded responses instead of calling out
#
# Replay only ever returns bytes a real run recorded, so it is honest about the
# contract while costing no billable operations. The UI labels a replayed run.
SUPERDOCS_REPLAY=off
SUPERDOCS_CASSETTE_DIR=server/cassettes

# --------------------------------------------------------------- ServiceNow
# "false" serves a mock ServiceNow instance from this process at
# /mock/servicenow — a real Table API with auth, encoded queries and PATCH,
# reached over HTTP by the same client that would talk to a live tenant.
SERVICENOW_ENABLED=false

# Credentials the mock instance accepts. Change them and the app still works;
# leave them and it works too. They exist so the auth path is exercised.
SERVICENOW_MOCK_USERNAME=svcflow.integration
SERVICENOW_MOCK_PASSWORD=mock-instance-secret

# Simulated instance behaviour, so the UI's loading and error states are
# exercised by something real rather than assumed. Enough delay to be real,
# little enough not to be felt. Raise it to make the loading states obvious;
# failure rate is 0-1.
SERVICENOW_MOCK_LATENCY_MS=60
SERVICENOW_MOCK_FAILURE_RATE=0

# Required only when SERVICENOW_ENABLED=true.
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Write the exported document back to the change record as a work note.
SERVICENOW_WRITE_BACK=true

# ------------------------------------------------------------------- server
PORT=8787
LOG_LEVEL=info

# Document runs are kept server-side. They expire, the store is bounded, and
# state survives a restart so a deploy does not strand an open review.
RUN_TTL_MS=3600000
RUN_LIMIT=200
RUN_STATE_PATH=.runs
