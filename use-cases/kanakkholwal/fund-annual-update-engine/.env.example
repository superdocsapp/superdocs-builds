# Copy to .env. Never commit .env.
SUPERDOCS_API_KEY=your-key-here
SUPERDOCS_API_BASE=https://api.superdocs.app

# Operation budget. The engine stops rather than silently spending past this.
FUND_UPDATE_MAX_OPERATIONS=25
# small-sample mode: process only the first N fields, for a cheap dry run
FUND_UPDATE_SAMPLE=0
