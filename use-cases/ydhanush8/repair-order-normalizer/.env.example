# Repair-Order Narrative Normalizer
#
# You do not need this file to run anything. The entire test suite and every
# CLI command work with no .env at all:
#
#   pip install -r requirements.txt
#   export PYTHONPATH=src
#   pytest
#   python -m ro_normalizer.cli process sample-data/orders.json --backend mock
#
# Copy this to .env only when you want to drive the real SuperDocs API.
#
# .env is git-ignored and must never be committed — this folder ships as a pull
# request into a public repository. A key committed here is a key published.

# ---------------------------------------------------------------
# Which editor the pipeline drives
#
#   mock       in-memory. No key, no network, no cost. Every test uses this,
#              and it reproduces the real API's quirks rather than an idealised
#              version of it.
#   superdocs  the real API. Needs SUPERDOCS_API_KEY.
#
# `--backend mock` and `--backend superdocs` override this per command, which is
# the safer habit: with EDITOR_BACKEND=superdocs set here, a command with no
# flag spends real operations.
# ---------------------------------------------------------------
EDITOR_BACKEND=mock

# ---------------------------------------------------------------
# SuperDocs — a key from Settings → API Keys, starting `sk_`.
#
# Only read when the backend is `superdocs`. Never log it, never let it into a
# screenshot.
# ---------------------------------------------------------------
SUPERDOCS_API_KEY=

# Optional. Defaults to https://api.superdocs.app.
SUPERDOCS_BASE_URL=

# Optional. Defaults to 300. Edits on large documents legitimately take minutes,
# so this is a timeout for a stall, not for slowness.
SUPERDOCS_TIMEOUT_SECONDS=300
