# Copy to .env and fill in. .env is gitignored.
#
# Get a key: POST https://api.superdocs.app/v1/agents/signup
#   {"terms_accepted": true, "agent_name": "your-agent-name"}
# The key is shown once. Free tier = 500 operations/month.
SUPERDOCS_API_KEY=sk_your_key_here

# Optional. Defaults to https://api.superdocs.app.
# SUPERDOCS_BASE_URL=https://api.superdocs.app
