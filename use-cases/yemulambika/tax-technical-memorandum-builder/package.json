{
  "name": "tax-technical-memorandum-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "bff": "tsx server/index.ts",
    "bff:offline": "tsx scripts/start-offline-bff.ts",
    "test:live": "tsx scripts/live-verify.ts",
    "test:ui": "playwright test --grep-invert @live",
    "test:ui:live": "playwright test --grep @live --config playwright.live.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
