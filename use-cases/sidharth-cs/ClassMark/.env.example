# Copy to .env and fill in. Never commit .env.
#
# Google Classroom Feedback add-on — Task 2B of the SuperDocs engineering
# task. Every variable here is read by backend/app/core/config.py.

# ---- Google OAuth (web application flow) ------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth 2.0
# Client ID -> Application type: Web application.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly:
#   http://localhost:8020/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- SuperDocs --------------------------------------------------------------
# docs.superdocs.app account -> create via POST /v1/users/me/api-keys.
# Shown once at creation; never printed, logged, or committed.
SUPERDOCS_API_KEY=
SUPERDOCS_BASE_URL=https://api.superdocs.app

# ---- Session -----------------------------------------------------------------
# Secret key for signing session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ---- Runtime ----------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8020
LOG_LEVEL=INFO
