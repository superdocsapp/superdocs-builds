# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# The app runs fully WITHOUT any of this: PROVIDER defaults to `fake`, a deterministic
# in-memory implementation of the same typed protocol the live client satisfies. That is
# how `docker compose up` gives you a working application on a fresh clone with no key.

# `fake` (default, offline, no cost) or `live` (real SuperDocs API)
PROVIDER=fake

# Only needed when PROVIDER=live. Get one at use.superdocs.app -> Settings -> API Keys.
SUPERDOCS_API_KEY=your-key-here

# Optional overrides
# SUPERDOCS_BASE_URL=https://api.superdocs.app
# DATABASE_URL=postgresql://inspect:inspect@db:5432/inspect
# LOG_FORMAT=json
