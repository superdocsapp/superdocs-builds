# Copy this file to .env and fill in your values.
# Never commit .env to the repository.

# Required: your SuperDocs API key (server-side only, never exposed to the browser)
SUPERDOCS_API_KEY=your-key-here

# Optional: Flask secret key for session signing (generate a random string)
FLASK_SECRET_KEY=change-this-to-a-random-string

# Optional: set to "true" to enable Flask debug mode (development only)
FLASK_DEBUG=false

# Optional: port to run the server on (default: 5000)
PORT=5000
