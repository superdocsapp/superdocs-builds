---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	parse(parse)
	match(match)
	propose(propose)
	review(review)
	apply(apply)
	redline(redline)
	outputs(outputs)
	verify(verify)
	__end__([<p>__end__</p>]):::last
	__start__ --> parse;
	apply -.-> propose;
	apply -.-> redline;
	apply -.-> review;
	match -.-> propose;
	match -.-> redline;
	outputs --> verify;
	parse --> match;
	propose --> review;
	redline --> outputs;
	review --> apply;
	verify --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

