# Copy to .env and fill in real values. Never commit .env itself.

ANTHROPIC_API_KEY=your-anthropic-key-here
SUPERDOCS_API_KEY=your-superdocs-key-here

# Only needed for idempotency-store tests / a real Postgres-backed run.
# Point at any local Postgres; the schema is created automatically.
DATABASE_URL=postgresql://localhost:5432/revrec_test
TEST_DATABASE_URL=postgresql://localhost:5432/revrec_test
