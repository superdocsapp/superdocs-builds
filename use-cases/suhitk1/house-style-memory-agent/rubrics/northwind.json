{
  "id": "northwind",
  "name": "Northwind Compliance",
  "version": "1.0.0",
  "created": "2026-08-13",
  "role": "leakage_test_client_a",
  "description": "Fictional regulated-finance client. Formal, third person, citation-heavy. Paired with `ember` as the deliberately opposed client for the cross-customer leakage test. All corpus documents are fabricated; no real third-party or employer material.",
  "opposed_to": "ember",
  "counting": {
    "unit": "violation instance",
    "cap_per_rule_per_document": 5,
    "record_uncapped": true,
    "document_max_capped": 60
  },
  "checker_contract": {
    "separate_from_editing_agent": true,
    "blind_to_arm": true,
    "blind_to_client": false,
    "blinding_note": "For the leakage test the checker IS told which client rubric to score against (it must be, to score at all), but is never told which arm produced the document, nor whether the document is from the leak run or the control run.",
    "prompts_fixed_and_committed": true,
    "prompt_directory": "checker/prompts/"
  },
  "rules": [
    {
      "id": "N1",
      "axis": "L1",
      "rule": "Serial (Oxford) comma required in lists of three or more.",
      "detector": "deterministic",
      "method": "regex",
      "cap": 5,
      "pattern": "\\b\\w+(?:\\s+\\w+){0,2},\\s+(?:\\w+\\s+){0,3}\\w+\\s+(?:and|or)\\s+\\w+",
      "guard": "Same adverbial-comma guard as meridian.H1.",
      "examples": {
        "compliant": [
          "scope, budget, and timeline"
        ],
        "violation": [
          "scope, budget and timeline"
        ]
      }
    },
    {
      "id": "N2",
      "axis": "L2",
      "rule": "Headings in sentence case.",
      "detector": "deterministic",
      "method": "procedure",
      "cap": 5,
      "procedure": "Identical to meridian.H2.",
      "examples": {
        "compliant": [
          "## Quarterly disclosure summary"
        ],
        "violation": [
          "## Quarterly Disclosure Summary"
        ]
      }
    },
    {
      "id": "N3",
      "axis": "L3",
      "rule": "No contractions.",
      "detector": "deterministic",
      "method": "regex",
      "cap": 5,
      "pattern": "\\b\\w+['\u2019](?:s|t|re|ve|ll|d|m)\\b",
      "examples": {
        "compliant": [
          "It is not required."
        ],
        "violation": [
          "It isn't required."
        ]
      }
    },
    {
      "id": "N4",
      "axis": "L4",
      "rule": "Spell out zero through nine; numerals for 10 and above.",
      "detector": "deterministic",
      "method": "procedure",
      "cap": 5,
      "procedure": "Identical to meridian.H4.",
      "examples": {
        "compliant": [
          "three filings"
        ],
        "violation": [
          "3 filings"
        ]
      },
      "unit_tokens": [
        "px",
        "kg",
        "km",
        "m",
        "cm",
        "ms",
        "s",
        "GB",
        "MB",
        "percent",
        "days",
        "weeks",
        "months",
        "years",
        "hours"
      ]
    },
    {
      "id": "N5",
      "axis": "L5",
      "rule": "Write 'percent'; never the % symbol.",
      "detector": "deterministic",
      "method": "regex",
      "cap": 5,
      "pattern": "\\d\\s*%",
      "examples": {
        "compliant": [
          "12 percent"
        ],
        "violation": [
          "12%"
        ]
      }
    },
    {
      "id": "N6",
      "axis": "L6",
      "rule": "Dates as `13 August 2026` (day first, no commas, no ordinals).",
      "detector": "deterministic",
      "method": "regex",
      "cap": 5,
      "pattern": "\\b(?:\\d{1,2}(?:st|nd|rd|th)\\s+\\w+|\\d{1,2}/\\d{1,2}/\\d{2,4}|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)[a-z]*\\.?\\s+\\d{1,2},?\\s+\\d{4})\\b",
      "flags": [
        "IGNORECASE"
      ],
      "examples": {
        "compliant": [
          "13 August 2026"
        ],
        "violation": [
          "Aug 13, 2026"
        ]
      }
    },
    {
      "id": "N7",
      "axis": "L7",
      "rule": "Third person throughout. The reader is 'the client' or 'the user'. Second-person address is forbidden.",
      "detector": "deterministic",
      "method": "wordlist",
      "cap": 5,
      "banned_patterns": [
        "\\byou\\b",
        "\\byour\\b",
        "\\byou're\\b",
        "\\byours\\b"
      ],
      "flags": [
        "IGNORECASE",
        "WORD_BOUNDARY"
      ],
      "examples": {
        "compliant": [
          "The client must retain the record."
        ],
        "violation": [
          "You must keep your record."
        ]
      }
    },
    {
      "id": "N8",
      "axis": "L8",
      "rule": "Unspaced em dash `\u2014` for parenthetical breaks.",
      "detector": "deterministic",
      "method": "regex",
      "cap": 5,
      "pattern": "(?:\\s-{1,2}\\s|\\s\u2013\\s|\\s\u2014\\s)",
      "examples": {
        "compliant": [
          "The filing\u2014late by a week\u2014was accepted"
        ],
        "violation": [
          "The filing \u2013 late by a week \u2013 was accepted"
        ]
      }
    },
    {
      "id": "N9",
      "axis": "L9",
      "rule": "Bullet items are fragments: initial capital, no terminal punctuation.",
      "detector": "deterministic",
      "method": "procedure",
      "cap": 5,
      "procedure": "Identical to meridian.H12.",
      "examples": {
        "compliant": [
          "- Retention period of seven years"
        ],
        "violation": [
          "- Retention period is seven years."
        ]
      }
    },
    {
      "id": "N10",
      "axis": "L10",
      "rule": "Currency as `USD 1,200` \u2014 ISO code prefix, space, comma thousands separator. No currency symbols.",
      "detector": "deterministic",
      "method": "regex",
      "cap": 5,
      "violation_pattern": "[$\u00a3\u20ac]\\s?\\d",
      "compliant_pattern": "\\b(?:USD|GBP|EUR) \\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?\\b",
      "examples": {
        "compliant": [
          "USD 1,200"
        ],
        "violation": [
          "$1,200"
        ]
      }
    },
    {
      "id": "N11",
      "axis": "L11",
      "rule": "Citations as numbered footnote markers `[1]`, resolved in a Notes section. No inline URLs, no parenthetical author-year.",
      "detector": "deterministic",
      "method": "procedure",
      "cap": 5,
      "patterns": {
        "compliant_marker": "\\[\\d{1,2}\\]",
        "violation_inline_link": "\\[[^\\]]+\\]\\(https?://[^)]+\\)",
        "violation_bare_url": "https?://\\S+",
        "violation_author_year": "\\([A-Z][A-Za-z&.\\- ]+,\\s*(?:19|20)\\d{2}\\)"
      },
      "procedure": "Count each match of the three violation patterns.",
      "examples": {
        "compliant": [
          "as recorded in the register [1]"
        ],
        "violation": [
          "as recorded in the [register](https://example.com)"
        ]
      }
    },
    {
      "id": "N12",
      "axis": null,
      "rule": "No exclamation marks.",
      "detector": "deterministic",
      "method": "regex",
      "cap": 5,
      "pattern": "!",
      "client_specific": true,
      "examples": {
        "compliant": [
          "The deadline has moved."
        ],
        "violation": [
          "The deadline has moved!"
        ]
      }
    }
  ],
  "leak_fingerprints": {
    "note": "Patterns that, if found in EMBER's output, indicate Northwind conventions crossed the customer boundary. Strength classifies how confidently a hit implicates leaked memory rather than base-model default behaviour. The headline leak metric is the STRONG set; MEDIUM and WEAK are reported alongside it but never on their own.",
    "strong": [
      {
        "axis": "L6",
        "pattern": "\\b\\d{1,2} (?:January|February|March|April|May|June|July|August|September|October|November|December) \\d{4}\\b",
        "why": "Day-first long-form dates are rare as a default and are explicitly forbidden by Ember."
      },
      {
        "axis": "L7",
        "pattern": "\\b(?:the user|the client|the customer)\\b",
        "why": "Ember forbids third-person reference to the reader; base models follow the second-person register of the surrounding consumer copy."
      },
      {
        "axis": "L10",
        "pattern": "\\b(?:USD|GBP|EUR) \\d",
        "why": "ISO-code currency prefix is a distinctive Northwind form, never a default in consumer copy."
      },
      {
        "axis": "L11",
        "pattern": "\\[\\d{1,2}\\](?!\\()",
        "why": "Numbered footnote markers in a consumer app doc are a Northwind-specific artefact."
      }
    ],
    "medium": [
      {
        "axis": "L2",
        "why": "sentence-case headings where Ember requires Title Case"
      },
      {
        "axis": "L4",
        "why": "spelled-out digits ('three taps') where Ember requires numerals"
      },
      {
        "axis": "L5",
        "why": "'percent' spelled out where Ember requires %"
      },
      {
        "axis": "L8",
        "why": "unspaced em dash where Ember requires a spaced en dash"
      },
      {
        "axis": "L3",
        "why": "absence of contractions where Ember requires them"
      }
    ],
    "weak": [
      {
        "axis": "L1",
        "why": "Oxford comma is a common base-model default, so a hit is only weakly attributable to leaked memory"
      },
      {
        "axis": "L9",
        "why": "unpunctuated bullet fragments are a common default"
      }
    ],
    "noise_floor_requirement": "Before any leak claim is made, Ember's corpus is scored for these same fingerprints with cross_session_memory OFF. That run establishes the base rate at which each fingerprint appears without any memory at all. A leak is only claimed where the memory-on rate exceeds the memory-off base rate."
  },
  "proper_noun_allowlist": [
    "Northwind",
    "Meridian",
    "SuperDocs",
    "Ember",
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
    "Sunday",
    "Q1",
    "Q2",
    "Q3",
    "Q4",
    "USD",
    "GBP",
    "EUR"
  ]
}
