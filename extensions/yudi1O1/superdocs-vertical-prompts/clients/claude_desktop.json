{
  "_file": "claude_desktop_config.json (macOS: ~/Library/Application Support/Claude/, Windows: %APPDATA%\\Claude\\)",
  "_replace": "Swap /absolute/path/to/superdocs-vertical-prompts for your real checkout path.",
