{
  "name": "obsidian-superdocs-living-note",
  "version": "0.1.0",
  "private": true,
  "description": "An Obsidian plugin that updates explicitly owned note sections through SuperDocs without touching human prose.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs development",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
