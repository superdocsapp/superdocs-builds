<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- The sample targets the current LTS only. The library is what multi-targets; a
         sample pinned to both would just double the build for no demonstration value. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UserSecretsId>superdocs-worker-sample</UserSecretsId>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Trim and AOT analysis is for the SHIPPED library. This is an application; it uses
         configuration binding, which is reflection-based by design and perfectly correct
         here. Applying library rules to a sample would make the sample less readable in
         order to demonstrate constraints the sample does not have. -->
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsAotCompatible>false</IsAotCompatible>

    <!-- CA1515: sample types are internal to the app by nature.
         CA1062: constructor arguments come from DI, which guarantees non-null.
         CA1308: file extensions are lowercase by convention.
         CA1873/CA1848: structured logging clarity beats LoggerMessage ceremony in a sample.
         CA1849/CA2007: startup console output and a worker with no synchronization context.
         CA1031: the watch loop must survive one bad file; catching broadly is the point. -->
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1062;CA1308;CA1873;CA1848;CA1849;CA2007;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <!-- The host's resilience policy. This is the whole point: retries, circuit breaking and
         timeouts are configured HERE, by the application, and the SDK inherits them. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SuperDocs.Client/SuperDocs.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="branding.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
