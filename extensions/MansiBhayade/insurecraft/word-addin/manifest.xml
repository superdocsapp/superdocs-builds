<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:type="TaskPaneApp">

    <Id>5c4e5e38-7a0b-4f7f-9d35-9c7f6e1d5a21</Id>

    <Version>1.0.0.0</Version>

    <ProviderName>MansiBhayade</ProviderName>

    <DefaultLocale>en-US</DefaultLocale>

    <DisplayName DefaultValue="InsureCraft"/>

    <Description
        DefaultValue="Insurance policy and endorsement builder powered by SuperDocs."
    />

    <IconUrl DefaultValue="https://via.placeholder.com/80"/>

    <SupportUrl DefaultValue="https://github.com/"/>

    <AppDomains>
        <AppDomain>https://localhost:3000</AppDomain>
    </AppDomains>

    <Hosts>
        <Host Name="Document"/>
    </Hosts>

    <DefaultSettings>
        <SourceLocation
            DefaultValue="https://localhost:3000/taskpane.html"
        />
    </DefaultSettings>

    <Permissions>ReadWriteDocument</Permissions>

</OfficeApp>