# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).

# --- Core service ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Database (async SQLAlchemy) ---
# docker-compose wires this automatically; shown here for local/manual runs.
DATABASE_URL=postgresql+asyncpg://superdocs:superdocs@localhost:5432/gateway

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379/0

# --- SuperDocs upstream ---
# The service holds ONE platform-side SuperDocs key. Tenant isolation is OUR
# responsibility and is enforced in our DB, not by SuperDocs.
SUPERDOCS_BASE_URL=https://api.superdocs.app
SUPERDOCS_API_KEY=your-superdocs-key-here

# --- Admin (tenant provisioning) ---
# Guards POST /v1/admin/tenants. Generate a long random value.
ADMIN_API_KEY=change-me-admin-key

# --- Webhooks (optional result delivery) ---
# If set, outgoing webhook payloads are signed with HMAC-SHA256 (X-Signature).
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

# --- Uploads ---
# Uploaded files are streamed to disk in chunks under this directory.
UPLOAD_DIR=/data/uploads
UPLOAD_CHUNK_SIZE=1048576          # 1 MiB read chunks
MAX_UPLOAD_BYTES=52428800          # 50 MiB hard cap, enforced while streaming

# --- Budget guard (protects the 10k free-op allowance) ---
# When true, bulk/loop operations refuse to run beyond SAMPLE_MAX_SECTIONS.
SAMPLE_MODE=true
SAMPLE_MAX_SECTIONS=25
