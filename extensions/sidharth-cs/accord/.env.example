# Copy to .env and fill in. Never commit .env.
#
# Grows one variable per milestone, only when code actually reads it — see
# PROGRESS.md.

# ---- Zoom (Milestone 0) ----------------------------------------------------
# Marketplace app "Live Deliverable" -> Feature -> Access -> Event
# Subscriptions -> Secret Token. Used to answer the endpoint.url_validation
# handshake and to verify every webhook's x-zm-signature header.
ZOOM_WEBHOOK_SECRET_TOKEN=

# ---- SuperDocs (Milestone 1) ------------------------------------------------
# docs.superdocs.app account -> create via POST /v1/users/me/api-keys.
# Shown once at creation; never printed, logged, or committed.
SUPERDOCS_API_KEY=

# ---- Live transcription provider (Milestones 4/6) ---------------------------
# vexa (default), manual, or rtms. Unknown values fall back to manual.
# See app/transcript/factory.py.
TRANSCRIPT_PROVIDER=vexa

# ---- Vexa (Milestone 6) -----------------------------------------------------
# Vexa is ONLY the live-listening mechanism: it joins the Zoom meeting as
# a bot and delivers transcript data; everything after ingestion is the
# existing Draft Engine's. Base URL of the Vexa API gateway (self-hosted
# gateway, or the hosted API when Zoom is supported there) and the
# gateway's X-API-Key. If either is blank, listening reports "Live
# transcription unavailable" and manual input stays available — the app
# never crashes on missing config.
VEXA_API_BASE_URL=
VEXA_API_KEY=
# Optional tuning — the bot's displayed name in the meeting and the
# transcription language.
VEXA_BOT_NAME=Live Deliverable
VEXA_LANGUAGE=en
VEXA_POLL_INTERVAL_SECONDS=3.0

# ---- RTMS (Milestone 4) -----------------------------------------------------
# rtms falls back to manual automatically if either secret below is blank
# — see app/transcript/factory.py.
# Marketplace app -> Basic Information -> App Credentials. Signs the RTMS
# websocket handshake; distinct from ZOOM_WEBHOOK_SECRET_TOKEN above.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- Groq STT (local audio-capture path) -------------------------------------
# console.groq.com API key. Used by app/transcript/groq_client.py to
# transcribe PCM chunks the Swift audio-fetcher posts to /audio.
GROQ_API_KEY=

# ---- Capture-helper control channel ------------------------------------------
# Shared secret for the Mac helper's outbound WSS connection to /api/ws/helper.
# Blank -> the helper endpoint rejects every connection. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
# Never commit the real value — set it in the Railway dashboard for prod and
# pass it to helper.py via this var (or --token) for local runs.
HELPER_AUTH_TOKEN=

# ---- Runtime ----------------------------------------------------------------
LOG_LEVEL=INFO
