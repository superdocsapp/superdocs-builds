# Copy to .env and fill in. Never commit .env.
#
# Nothing here is needed to run the test suite. The whole suite — the
# behavioural vectors and all three fault-injection scenarios — runs with no
# API key and no network. These variables are only read by the optional live
# smoke test (`make smoke`), which spends real metered operations.

# docs.superdocs.app account -> create via POST /v1/users/me/api-keys.
# Shown once at creation; never printed, logged, or committed.
SUPERDOCS_API_KEY=your-key-here
SUPERDOCS_BASE_URL=https://api.superdocs.app

# Hard ceiling on metered operations for one live run. The smoke script counts
# every billable call itself and stops at this number rather than trusting the
# script to be correct.
IDEM_SMOKE_MAX_OPERATIONS=25
