# SuperDocs API key (sk_...). Get it at https://use.superdocs.app → Settings → API Keys.
# Keep this server-side only; never commit the real value.
SUPERDOCS_API_KEY=sk_replace_me

# Export format for approved documents: docx | pdf | html | markdown | txt
EXPORT_FORMAT=docx

# HTML the app seeds a fresh draft with before applying the requested edits.
SEED_TEMPLATE=<h1>Draft</h1><p>Replace this with the requested content.</p>

# Google Chat webhook auth. Leave UNSET for local dev (auth disabled). In
# production set it to the audience configured on the Chat app connection
# (your GCP project number, or the app's public URL). Requests whose signed JWT
# doesn't match are rejected with 401.
GOOGLE_CHAT_AUDIENCE=

# Shared secret a scheduler (e.g. Cloud Scheduler) presents to POST /tasks/daily-digest.
DIGEST_TOKEN=
