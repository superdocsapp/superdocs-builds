{
  "name": "@superdocs/knowledge-base-freshness-sweeper",
  "version": "1.0.0",
  "description": "Multi-stage impact discovery, surgical editing, and portfolio freshness sweeper for knowledge-base maintenance.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "sweep": "tsx src/cli/index.ts sweep",
    "sweep:interactive": "tsx src/cli/index.ts sweep --interactive",
    "export:report": "tsx src/cli/index.ts sweep --export docs/freshness-report.md",
    "evaluate": "tsx src/cli/index.ts evaluate",
    "verify": "tsx scripts/verify-all.ts",
    "generate:gif": "tsx scripts/generate-demo-gif.ts",
    "server": "tsx src/api/server.ts"
  },
  "keywords": [
    "superdocs",
    "knowledge-base",
    "freshness-sweeper",
    "surgical-editing",
    "documentation-maintenance",
    "change-impact-analysis"
  ],
  "author": "Harsh Raghuwanshi <deadheaven07>",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "gif-encoder-2": "^1.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
