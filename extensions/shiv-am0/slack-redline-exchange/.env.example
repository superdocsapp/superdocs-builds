# Copy this file to .env and fill in real values. `.env` is gitignored; never commit keys.
#   cp .env.example .env
# Precedence: real environment variables > .env > defaults in src/redline/config.py
# This file (.env.example) is a TEMPLATE and is never read by the application.

# ---------------------------------------------------------------------------
# SuperDocs
# ---------------------------------------------------------------------------
# FAKE_MODE=true runs against the in-process FakeSuperDocs: no key, no network, no cost,
# and nothing appears in the SuperDocs UI. Set it to false to use the real API.
FAKE_MODE=true
SUPERDOCS_API_KEY=sk_your_superdocs_key_here
SUPERDOCS_BASE_URL=https://api.superdocs.app

# ---------------------------------------------------------------------------
# Slack  (only needed to run the real Slack app: uv run python -m redline.slack.run_slack)
# ---------------------------------------------------------------------------
# Bot User OAuth Token  — Slack app config → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-Level Token with connections:write — Basic Information → App-Level Tokens.
# Required for Socket Mode, which is how this app connects without a public URL.
SLACK_APP_TOKEN=xapp-your-app-token
# Basic Information → Signing Secret. Unused in Socket Mode but kept for HTTP mode.
SLACK_SIGNING_SECRET=your-signing-secret

# ---------------------------------------------------------------------------
# Channels and workspaces
# ---------------------------------------------------------------------------
# Channel IDs (NOT names): open the channel → click its name → About → copy the ID.
# SHARED_CHANNEL is the Slack Connect channel both companies can see.
SHARED_CHANNEL=C_SHARED
# Each side's private, internal-only channel. Nothing here ever reaches SHARED_CHANNEL.
VENDOR_INTERNAL_CHANNEL=C_INT_VENDOR
CUSTOMER_INTERNAL_CHANNEL=C_INT_CUSTOMER

# Workspace/team IDs decide which side a user acts as. Find yours at
# https://<workspace>.slack.com/account/team or in any event payload (team_id).
# For single-workspace testing, set both to your own team ID and see the README note
# about SIDE_OVERRIDE_USERS.
VENDOR_TEAM_ID=T_VENDOR
CUSTOMER_TEAM_ID=T_CUSTOMER

# ---------------------------------------------------------------------------
# Two-workspace mode (real Slack Connect)
# ---------------------------------------------------------------------------
# Leave ALL FOUR of these empty to run single-workspace mode using the SLACK_*
# tokens above. Fill in all four to run one Slack app per company, connected by a
# Slack Connect channel -- the closest match to how this would really be deployed.
# Each pair comes from that workspace's own app at https://api.slack.com/apps:
#   *_BOT_TOKEN  -> OAuth & Permissions -> Bot User OAuth Token   (xoxb-...)
#   *_APP_TOKEN  -> Basic Information  -> App-Level Tokens        (xapp-...)
# VENDOR_TEAM_ID and CUSTOMER_TEAM_ID must differ in this mode; SIDE_OVERRIDE_USERS
# is not needed, because the workspace a person belongs to decides their side.
VENDOR_BOT_TOKEN=
VENDOR_APP_TOKEN=
CUSTOMER_BOT_TOKEN=
CUSTOMER_APP_TOKEN=

# Optional: force specific Slack user IDs onto a side, for testing both roles from one
# workspace. Format: U123456:vendor,U789012:customer
SIDE_OVERRIDE_USERS=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# dual_consent  = a change commits only when BOTH sides approve it (default)
# proposer_only = the proposing side's approval alone commits it
APPROVAL_POLICY=dual_consent

DATABASE_PATH=./redline.db

# Job polling. Real SuperDocs jobs can take 30s-several minutes on large documents.
POLL_INTERVAL_SECONDS=2.0
# After this many seconds with no turnpoint, post a "still working" note to the channel.
WARN_AFTER_SECONDS=30
MAX_JOB_WAIT_SECONDS=900

# How long an identical propose folds into the previous job instead of starting (and
# billing) a second one. Jobs still awaiting review dedupe regardless of age; this only
# covers repeats after one has finished. Set to 0 to dedupe in-flight jobs only.
IDEMPOTENCY_WINDOW_SECONDS=120
