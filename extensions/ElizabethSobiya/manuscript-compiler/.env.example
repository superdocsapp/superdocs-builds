# Copy to .env and fill in. Never commit the real file.
# Get a key at https://use.superdocs.app (Settings -> API Keys),
# or let an agent create one: POST https://api.superdocs.app/v1/agents/signup
SUPERDOCS_API_KEY=your-key-here

# Optional: override the API base (defaults to https://api.superdocs.app)
# SUPERDOCS_API_BASE=https://api.superdocs.app
