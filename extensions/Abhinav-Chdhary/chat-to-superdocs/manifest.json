{
  "manifest_version": 3,
  "name": "Chat to SuperDocs",
  "description": "Capture a ChatGPT or Claude answer and review it in a growing SuperDocs document.",
  "version": "0.1.0",
  "icons": {
    "16": "assets/icons/chat-to-superdocs-16.png",
    "32": "assets/icons/chat-to-superdocs-32.png",
    "48": "assets/icons/chat-to-superdocs-48.png",
    "128": "assets/icons/chat-to-superdocs-128.png"
  },
  "action": {
    "default_title": "Chat to SuperDocs settings",
    "default_icon": {
      "16": "assets/icons/chat-to-superdocs-16.png",
      "32": "assets/icons/chat-to-superdocs-32.png",
      "48": "assets/icons/chat-to-superdocs-48.png",
      "128": "assets/icons/chat-to-superdocs-128.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1:8787/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
