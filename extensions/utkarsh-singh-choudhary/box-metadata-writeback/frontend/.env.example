# Copy to .env (Vite auto-loads .env in this directory). Both are
# optional for local dev against an unauthenticated local backend.

# Base URL of the backend API. Defaults to http://localhost:8000 if unset.
VITE_API_BASE=http://localhost:8000

# Only useful for local dev convenience (skips the in-app "API key
# required" prompt on first load). NEVER set this for a real deployed
# build -- it gets bundled into the built JS and is visible to anyone
# who opens dev tools. For a real deployment, leave this unset and let
# each person enter their own key through the in-app prompt; it's kept
# in sessionStorage only, per browser tab.
VITE_API_KEY=
