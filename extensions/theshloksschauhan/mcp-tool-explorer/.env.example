# Optional. When set, the explorer uses this key only on the server.
# The browser never receives it. Leave unset to type a key into the UI;
# that key is sent once to this server and kept in memory for the session.
# SUPERDOCS_API_KEY=sk_your_key_here

# Canonical SuperDocs MCP endpoint. Streamable HTTP. Do not commit a key.
# SUPERDOCS_MCP_URL=https://api.superdocs.app/mcp/

# SUPERDOCS_EXPLORER_HOST=127.0.0.1
# SUPERDOCS_EXPLORER_PORT=8787
# SUPERDOCS_MCP_TIMEOUT_MS=60000
# SUPERDOCS_SESSION_TTL_MS=1800000
