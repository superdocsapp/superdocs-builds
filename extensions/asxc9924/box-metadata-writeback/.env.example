# Copy to .env and fill in for a real deployment. `make bootstrap` / `make
# test` / `make run` all work with none of this set -- everything below
# is optional for local dev and eval, and becomes required (marked below)
# for a real production deployment.

# --- Deployment mode -------------------------------------------------------

# Set to "production" to make the app refuse to start without
# WORKFLOW_API_KEYS set. Anything else (including unset) is treated as
# local/dev and runs with auth disabled if no keys are configured.
ENVIRONMENT=development

# --- Auth (REQUIRED for any real deployment) --------------------------------

# Comma-separated list of valid bearer tokens. Every endpoint except
# /healthz and /webhook/box (which Box authenticates via HMAC signature,
# see BOX_WEBHOOK_* below) requires `Authorization: Bearer <one of these>`.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# This is the SINGLE-TENANT path: each key here becomes its own isolated
# tenant (tenant-0, tenant-1, ...), all sharing this deployment's
# top-level BOX_*/SUPERDOCS_* credentials below. Fine for one customer.
# For more than one customer with separate Box connections, use
# TENANTS_CONFIG_PATH instead (see below) -- don't set both.
WORKFLOW_API_KEYS=

# --- Multi-tenancy (for serving more than one customer from one deployment) --

# Path to a JSON file: a list of tenant objects, each with tenant_id,
# api_key, and optionally box_client_id / box_client_secret /
# box_enterprise_id / box_jwt_private_key / superdocs_api_key to give
# that tenant their own Box/SuperDocs connection instead of sharing this
# deployment's top-level credentials. Example:
# [
#   {"tenant_id": "acme-corp", "api_key": "sk_acme_...",
#    "box_client_id": "...", "box_client_secret": "...",
#    "box_enterprise_id": "...", "box_jwt_private_key": "..."},
#   {"tenant_id": "globex-corp", "api_key": "sk_globex_..."}
# ]
# If set, this takes priority over WORKFLOW_API_KEYS. See
# tests/test_multitenancy.py for what isolation this actually proves,
# and app/tenancy.py's module docstring for what's still missing (a
# self-serve OAuth "Connect your Box account" flow -- these credentials
# are still supplied by an operator, not collected from the customer).
TENANTS_CONFIG_PATH=

# --- Rate limiting -----------------------------------------------------------

# Requests per minute per API key (or per source IP if no key is sent).
# This is a floor against a single misbehaving caller, not a substitute
# for a real gateway/WAF in front of a production deployment.
WORKFLOW_RATE_LIMIT_PER_MINUTE=120

# --- Demo data (NEVER set this in a real deployment) -------------------------

# Enables POST /demo/seed, which loads synthetic documents into the
# in-memory FakeBoxClient. Refuses to run against a real Box client
# regardless of this flag -- but leave it unset outside of demos anyway.
WORKFLOW_ENABLE_DEMO_SEED=false

# --- CORS ---------------------------------------------------------------------

# Comma-separated list of origins allowed to call this API from a
# browser (the review console in frontend/). Defaults to the local Vite
# dev/preview ports; set to your real frontend's deployed origin(s) in
# production.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Logging -------------------------------------------------------------------

LOG_LEVEL=INFO

# --- Persistence ----------------------------------------------------------------

# Directory backing each tenant's SQLite-based checkpoints, idempotency
# records, review queue, and metadata history/audit trail -- one file
# per tenant (tenant-<id>.db) is created inside it, not a single shared
# file. Defaults to in-memory (non-durable) stores if unset -- point
# this at a directory on a persistent volume in any real deployment,
# since the container filesystem is not durable across restarts.
PERSISTENCE_DB_PATH=./data

# --- Real Box integration (all four required together to use RealBoxClient) ----

# Falls back to the in-memory FakeBoxClient if any of these are unset --
# see app/clients/real_box_client.py:RealBoxClient.from_env().
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_JWT_PRIVATE_KEY=

# HMAC keys Box signs webhook deliveries with (from the Box Developer
# Console webhook configuration). Required for /webhook/box to accept
# real Box webhook calls -- without these set, the signature check
# always fails closed (401), it never falls back to "unverified".
BOX_WEBHOOK_PRIMARY_KEY=
BOX_WEBHOOK_SECONDARY_KEY=

# --- Real SuperDocs integration -------------------------------------------------

# Falls back to the in-memory FakeSuperDocsClient if unset.
SUPERDOCS_API_KEY=
SUPERDOCS_API_BASE=https://api.superdocs.app
SUPERDOCS_MODEL_TIER=
SUPERDOCS_MAX_OPERATIONS=20
SUPERDOCS_POLL_TIMEOUT_SECONDS=480
