GOOGLE_API_KEY="YOUR_API_KEY_HERE"
GEMINI_MODEL="gemini-3.5-flash-lite"

# SuperDocs settings
SUPERDOCS_API_KEY="sk_..."
SUPERDOCS_DOCUMENT_ID="your-saved-document-id"
SUPERDOCS_SESSION_ID=""
SUPERDOCS_WRITE_BACK="true"
SUPERDOCS_APPROVAL_MODE="approve_all"
SUPERDOCS_EXPORT_FORMAT="pdf"
SUPERDOCS_EXPORT_PATH="exports/fetched-demo.pdf"
SUPERDOCS_VERBOSE="true"

# Comma-separated logical section names supplied to the demo extractor
DOCUMENT_SECTIONS="invoice-details,payment-terms,items-and-pricing,notes"
SPELLING_SECTIONS="payment-terms,notes"
MATH_SECTION="items-and-pricing"

USE_GEMINI="true"
DEMO_LOG_PATH="logs/fetched-demo.json"
