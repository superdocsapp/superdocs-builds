# Copy to .env and fill in. Never commit .env.

# --- Confluence Cloud ---
# Scoped API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Scopes: read:page, write:page, read:space, read:hierarchical-content, read:content,
#         read:label, write:label, read:comment, write:comment, read:user  (all :confluence)
#
# CONFLUENCE_BASE_URL is the SITE origin. It is used to build human-facing page links
# and to resolve the cloudId. API calls do not go here: a scoped token is rejected with
# 401 by the site host and must go through https://api.atlassian.com/ex/confluence/
# <cloudId>. preflight.py discovers the working combination; do not hardcode it.
CONFLUENCE_BASE_URL=https://your-site.atlassian.net
CONFLUENCE_EMAIL=service-account@example.com
CONFLUENCE_API_TOKEN=your-scoped-token-here
CONFLUENCE_SPACE_KEY=RUNBOOKS
# Only pages carrying this label are reconciled.
CONFLUENCE_RUNBOOK_LABEL=runbook

# --- SuperDocs ---
# See docs.superdocs.app for the current base URL.
SUPERDOCS_API_KEY=your-key-here
SUPERDOCS_API_BASE=

# --- Ground truth (read-only) ---
# Local checkouts. Multi-repo: comma-separated.
INFRA_REPO_PATHS=/path/to/infra-repo
SERVICE_CATALOG_PATH=/path/to/catalog-info-files
ALERT_RULES_GLOB=**/*.rules.yml
