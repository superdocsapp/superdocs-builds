# ─────────────────────────────────────────────────────────────────────────────
#  Redaction Pane — a Word add-in. Standalone: no analyst, no Postgres.
#
#      npx office-addin-dev-certs install     # once, on the HOST
#      cp .env.example .env                   # fill in the two keys
#      docker compose up
#      cp manifest.xml ~/Library/Containers/com.microsoft.Word/Data/Documents/wef/
#      # restart Word → Home → Add-ins → Redaction Pane
#
#  This file is deliberately separate from the repo-root .env.example. This app
#  does not import doctask-core and must run from a `cp -r` into someone else's
#  repository, so it cannot inherit the analyst's configuration.
# ─────────────────────────────────────────────────────────────────────────────

# Every value here is read when a container STARTS. Editing this file under a
# running service changes nothing — `make restart` is what re-reads it.

# --- Required --------------------------------------------------------------
# Export of a cleaned file. Scanning, review and in-place redaction all work
# without it, and /health says so rather than failing at the click.
SUPERDOCS_API_KEY=
# LLM provider for tier 3 — openai, gemini or anthropic. This ALSO decides which
# SDK the image installs: the build reads it as a build arg and pulls exactly
# that provider's client (see docker-compose.yml + Dockerfile), so the image
# carries one provider, not three.
#
# openai is the DEFAULT and the client always present. To run gemini or
# anthropic, set it here and `make up` (a rebuild) so the image installs that
# SDK. A plain restart re-reads .env but does NOT re-pull dependencies, so
# switching provider needs the rebuild; /health names the active provider and
# says if its SDK is missing.
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Tier 3 only: names in prose, addresses and privileged passages. Blank runs
# the model pinned in service/settings.py — gpt-4o, gemini-3.6-flash or
# claude-sonnet-5, whichever matches LLM_PROVIDER. Set it to run something else.
LLM_MODEL_PII=

# --- SuperDocs -------------------------------------------------------------
SUPERDOCS_BASE_URL=https://api.superdocs.app
SD_TIMEOUT_S=120

# --- Serving ---------------------------------------------------------------
# Nothing to set. HTTPS is NOT optional — Office refuses an http:// task pane,
# even on localhost — but the port and the certificate paths are uvicorn's
# command line, in the Dockerfile. There were four settings here that no code
# ever read; changing them changed nothing, which is worse than not offering
# them. Docker is the only supported run path (see README § "Only Docker").

# --- Storage ---------------------------------------------------------------
# SQLite, so a reviewer needs no database to run this. Relative to the app
# folder; compose mounts ./data over it so the audit log survives a restart.
DATA_DIR=./data

# --- PII detection ---------------------------------------------------------
# Tier 1 patterns (ours, deterministic) · tier 2 GLiNER · tier 3 LLM.
#
# Tier 2 is ON, and the Docker image carries the model — downloaded at build
# time, so no scan ever waits for it and the running service needs no network
# for tiers 1 and 2. /health reports whether the package is actually importable,
# so this being true is never mistaken for the tier having run.
GLINER_ENABLED=true
GLINER_MODEL=knowledgator/gliner-pii-base-v1.0
GLINER_THRESHOLD=0.5
# Tier 3. Off only if you have no model key at all; the pane reports which
# tiers actually ran, so a scan with it off cannot look like a clean document.
LLM_ENABLED=true

# --- Behaviour -------------------------------------------------------------
# There is no marker setting. What replaces a span is derived from what was
# found — `[CREDIT CARD REDACTED]`, `[NAME REDACTED]` — because a document
# redacted entirely to `[REDACTED]` is no longer reviewable. See
# service/markers.py.
# Refuse to report success if any confirmed string survives anywhere in the
# exported package — not just the document body.
VERIFY_EXPORT=true
