# Nothing here belongs in a `cp -r` handoff to someone else's repository.
# Everything below has been left behind by a tool at least once — running
# pytest, ruff or uv inside this folder all create something.
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
.env
.localcerts/
# The whole data directory. It holds the SQLite log AND every exported log
# file, and an exported log quotes the contract it came from — names,
# diagnoses, account numbers, verbatim. `data/*.db` alone left those
# committable, which for a redaction tool is the worst possible leak: the
# artefact proving the document was cleaned, carrying the text that was removed.
data/
ui/node_modules/
ui/dist/
ui/tsconfig.tsbuildinfo
# Generated by scripts/make_sample.py. A .docx in a pull request is a file
# nobody can diff; the script that writes it is readable.
sample/
