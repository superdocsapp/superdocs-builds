<?xml version="1.0" encoding="UTF-8"?>
<!--
  What Word reads to decide this add-in exists.

  Sideload (Mac):
      cp manifest.xml ~/Library/Containers/com.microsoft.Word/Data/Documents/wef/
      restart Word  →  Home  →  Add-ins  →  Redaction Pane

  Two things in here are not negotiable and both are Office's rules, not ours:

    * SourceLocation MUST be https. Word refuses an http:// task pane even on
      localhost, which is why `npx office-addin-dev-certs install` is a
      prerequisite and why the service runs with a key and certificate.
    * The AppDomains list must contain every origin the pane navigates to.
      Ours is one origin — the service serves the pane and answers its API —
      so there is one entry.

  ReadWriteDocument, because redaction writes: the marker replaces the span in
  the open document. Nothing is written without a click on a row.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>0441A235-B2AE-4793-8135-39BDCF50D1B1</Id>
  <!-- Office rejects anything below 1.0.0.0 outright — its own validator calls
       it "Manifest Version Too Low", and a sideload just silently does not
       appear. Found by running `office-addin-manifest validate`. -->
  <Version>1.0.0.0</Version>
  <ProviderName>Devansh Nigam</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Redaction Pane"/>
  <Description DefaultValue="Scan the open document for personal, health, account and privileged content. Confirm each finding, redact it in place, and export a clean file with a log of what was removed and by whom."/>
  <IconUrl DefaultValue="https://localhost:8443/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:8443/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://localhost:8443/health"/>

  <AppDomains>
    <AppDomain>https://localhost:8443</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="WordApi" MinVersion="1.3"/>
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:8443/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="RedactionGroup">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="OpenPaneButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>RedactionPaneId</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:8443/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:8443/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:8443/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:8443/taskpane.html"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://localhost:8443/health"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Redaction"/>
        <bt:String id="Button.Label" DefaultValue="Redaction Pane"/>
        <bt:String id="GetStarted.Title" DefaultValue="Redaction Pane is ready"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="Scan this document for personal, health, account and privileged content."/>
        <bt:String id="GetStarted.Description" DefaultValue="Open the pane from Home, scan the document, and confirm each finding before it is redacted."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
