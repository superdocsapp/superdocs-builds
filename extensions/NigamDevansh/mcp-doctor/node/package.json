{
  "name": "@superdocs/mcp-doctor",
  "version": "0.1.0",
  "description": "Diagnose and fix SuperDocs MCP client configuration",
  "type": "module",
  "bin": {
    "mcp-doctor": "./dist/cli.js"
  },
  "files": [
    "dist",
    "shared"
  ],
  "scripts": {
