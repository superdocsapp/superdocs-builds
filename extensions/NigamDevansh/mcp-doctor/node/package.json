    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
