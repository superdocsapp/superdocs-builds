            ".mcp.json": "﻿{\n  \"mcpServers\": {\n    \"superdocs\": {\n      \"type\": \"http\",\n      \"url\": \"https://api.superdocs.app/mcp\",\n      \"headers\": {\n        \"Authorization\": \"Bearer sk_fixture_bom_00000000000\"\n      }\n    }\n  }\n}\n"
