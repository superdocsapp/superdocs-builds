    {
      "name": "crlf-preserved",
      "description": "Windows line endings survive a repair untouched.",
      "raw_files": {
        ".mcp.json": "{\r\n  \"mcpServers\": {\r\n    \"superdocs\": {\r\n      \"type\": \"http\",\r\n      \"url\": \"http://api.superdocs.app/mcp\",\r\n      \"headers\": {\r\n        \"Authorization\": \"Bearer sk_fixture_crlf_0000000000\"\r\n      }\r\n    }\r\n  }\r\n}\r\n"
      },
      "expect": {
        "scan": {
          "exit_code": 1,
          "findings": [
            {
              "id": "config.scheme-insecure",
              "severity": "error"
            }
          ]
        },
        "fix": {
          "exit_code": 0,
          "findings": [
            {
              "id": "config.scheme-insecure",
              "fixed": true
            }
          ],
          "backup_expected": true,
          "files": {
            ".mcp.json": "{\r\n  \"mcpServers\": {\r\n    \"superdocs\": {\r\n      \"type\": \"http\",\r\n      \"url\": \"https://api.superdocs.app/mcp\",\r\n      \"headers\": {\r\n        \"Authorization\": \"Bearer sk_fixture_crlf_0000000000\"\r\n      }\r\n    }\r\n  }\r\n}\r\n"
          }
        }
      },
      "_why": "A naive parse-and-reserialise silently converts CRLF to LF, rewriting every line of a Windows developer's file and burying the real change in a whole-file diff."
    },
