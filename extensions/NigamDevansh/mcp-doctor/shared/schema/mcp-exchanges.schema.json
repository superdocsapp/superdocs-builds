{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superdocs.app/mcp-doctor/schema/mcp-exchanges.json",
  "title": "Recorded MCP HTTP exchanges",
  "description": "Evidence behind the endpoint profile, and the replay source for the fake server. Separates what was OBSERVED from what was WRITTEN, so a fake server is never quietly built on assumption.",
  "type": "object",
  "required": ["exchanges_version", "endpoint", "exchanges"],
  "properties": {
    "$schema": { "type": "string" },
    "_readme": { "type": "array", "items": { "type": "string" } },
    "exchanges_version": { "type": "integer", "minimum": 1 },
    "endpoint": { "const": "https://api.superdocs.app/mcp" },
    "exchanges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exchange" } }
  },
  "additionalProperties": false,

  "$defs": {
    "exchange": {
      "type": "object",
      "required": ["name", "source", "purpose", "request", "response"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "source": {
          "enum": ["captured", "constructed"],
          "description": "captured = observed live on `date`. constructed = written to a documented shape, never observed."
        },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sanitised": { "type": "array", "items": { "type": "string" } },
        "truncated": { "type": "boolean" },
        "expected_totals": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "purpose": { "type": "string", "minLength": 1 },
        "replay_note": { "type": "string" },
        "request": {
          "type": "object",
          "required": ["method", "path", "headers"],
          "properties": {
            "method": { "enum": ["GET", "POST"] },
            "path": { "type": "string" },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "body": { "type": "object" }
          },
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "required": ["status", "headers"],
          "properties": {
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "body": { "type": "object" },
            "body_text": { "type": "string", "description": "For non-JSON responses, such as an interceptor's HTML login page." }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "A captured exchange must say when it was captured.",
          "if": { "properties": { "source": { "const": "captured" } }, "required": ["source"] },
          "then": { "required": ["date"] }
        }
      ]
    }
  }
}
