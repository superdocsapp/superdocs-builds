# Copy to .env. The .env file is gitignored and must stay that way.
#
#   cp .env.example .env

# The only required value. This is the real SuperDocs key the gateway holds on
# behalf of every team — it is why no agent needs one of its own. It is read
# from the environment at startup and never written to policy.yml or the image.
SUPERDOCS_API_KEY=

# Everything below has a working default in gateway/settings.py; set them only
# to override. Note the GATEWAY_ prefix.

# GATEWAY_UPSTREAM_URL=https://api.superdocs.app/mcp

# No policy file → transparent passthrough. Deploy that way first to confirm
# nothing breaks, then add policy.yml and restart to switch enforcement on.
# GATEWAY_POLICY_PATH=policy.yml

# The audit log. compose mounts ./data over this, so the chain survives a
# restart. If this path is not writable the gateway refuses to start.
# GATEWAY_AUDIT_LOG_PATH=data/audit.jsonl

# GATEWAY_LISTEN_PORT=8080
