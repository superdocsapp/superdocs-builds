NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# GitHub App settings. Fill these after creating the GitHub App.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_BASE64=

# SuperDocs settings. Keep real keys out of git and screenshots.
SUPERDOCS_API_KEY=
SUPERDOCS_API_BASE_URL=https://api.superdocs.app

# Local persistence for Sprint 0/Sprint 1.
DATABASE_URL=file:./data/dev.sqlite
ARTIFACTS_DIR=./artifacts
PUBLIC_ARTIFACT_BASE_URL=
