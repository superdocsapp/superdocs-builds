# Copy to .env and fill in. .env is gitignored and must never be committed.

# Your SuperDocs API key, from use.superdocs.app -> Settings -> API Keys.
SUPERDOCS_API_KEY=your-key-here

# Optional. Defaults to https://api.superdocs.app
# Point this at a local FakeSuperDocs instance to run without spending operations.
SUPERDOCS_BASE_URL=https://api.superdocs.app
