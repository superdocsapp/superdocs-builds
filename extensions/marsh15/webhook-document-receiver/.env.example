SUPERDOCS_API_KEY=sk_your-key-here
WEBHOOK_SECRET=replace-with-at-least-32-random-characters
GITHUB_WEBHOOK_SECRET=replace-with-a-distinct-32-character-secret
MANAGEMENT_TOKEN=replace-with-a-different-32-character-secret
MANAGEMENT_ACTOR_ID=operator
ROUTES_PATH=routes/routes.yaml
TEMPLATES_PATH=templates
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhook_receiver
DATABASE_POOL_MAX_SIZE=10
WORKER_LEASE_SECONDS=600
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_MAX_RETRIES=3
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=300
MAX_ARTIFACT_BYTES=10485760
SIGNATURE_TOLERANCE_SECONDS=300
MAX_BODY_BYTES=1048576
MAX_JSON_DEPTH=20
MAX_JSON_NODES=10000
INITIAL_ROUTE_ID=incident-report
INITIAL_ROUTE_EVENT_TYPE=incident.resolved
INITIAL_ROUTE_VERSION=t2-a-v1
INITIAL_ROUTE_FIELDS=type,incident_id,title,summary,resolved_at
INITIAL_ROUTE_APPROVAL_MODE=manual
EXPORT_FORMAT=docx
DOCUMENT_INSTRUCTION=Create a concise event report. State only facts present in the event payload.
SUPERDOCS_BASE_URL=https://api.superdocs.app
SUPERDOCS_TIMEOUT_SECONDS=180
JOB_POLL_INTERVAL_SECONDS=2
JOB_TIMEOUT_SECONDS=600
