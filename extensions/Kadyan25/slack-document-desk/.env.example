# Postgres (used by docker-compose to configure the db service)
POSTGRES_USER=docdesk
POSTGRES_PASSWORD=docdesk
POSTGRES_DB=docdesk

# DATABASE_URL is set automatically by docker-compose for the backend container.
# Override here only if running the backend outside compose.
# DATABASE_URL=postgresql+psycopg://docdesk:docdesk@localhost:55433/docdesk

# Slack app credentials — create a free app at https://api.slack.com/apps
# (Socket Mode off; this app receives events over HTTP at /slack/events — both
# Event Subscriptions AND Interactivity & Shortcuts need their Request URL set,
# they're separate settings. See README.md for the full order of steps.)
# Needed scopes: app_mentions:read, chat:write, files:read, files:write, im:write,
# im:history, users:read
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me

# SuperDocs API key — https://use.superdocs.app (account settings -> API keys)
SUPERDOCS_API_KEY=replace-me
SUPERDOCS_API_BASE_URL=https://api.superdocs.app

APP_PORT=8000
