{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/superdocs/changelog/release-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_id", "title", "date", "items"],
  "properties": {
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "title", "body"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "category": {"type": "string", "enum": ["Added", "Changed", "Fixed", "Deprecated", "Removed"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "body": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
