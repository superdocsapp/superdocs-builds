# Copy this file to backend/.env (config.py loads backend/.env first,
# then backend/config/.env). Never commit the real .env — it's gitignored.

# --- SuperDocs (https://api.superdocs.app) ---
SUPERDOCS_API_KEY=sk_your_key_here
SUPERDOCS_API_BASE=https://api.superdocs.app
# Base session id. Each document gets its OWN session derived from this
# ("<base>-doc-<hash>"): a SuperDocs session holds one active document, so
# sharing a session across a corpus makes every upload overwrite the last.
DRIFT_SUPERDOCS_SESSION=drift-detector-main
# One wrong word matters when applying an edit — 'max' is the strongest tier.
DRIFT_SUPERDOCS_MODEL=max

# --- Anthropic on Microsoft Foundry ---
ANTHROPIC_ENDPOINT=https://<your-resource>.services.ai.azure.com/anthropic/
ANTHROPIC_DEPLOYMENT=claude-opus-5
ANTHROPIC_API_KEY=your_key_here

# --- Azure OpenAI (fallback provider) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Database (matches backend/config/docker-compose.yml) ---
DRIFT_DB_URL=postgresql+asyncpg://drift_detector:drift_detector@localhost:5432/drift_detector

# --- Budget ---
DRIFT_BUDGET_MAX_OPS=200
DRIFT_BUDGET_MAX_TOKENS=100000
DRIFT_RETRIEVER_TOP_K=10
