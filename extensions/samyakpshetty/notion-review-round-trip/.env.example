# Copy to .env and fill in. .env is gitignored and never committed.
# The entire test suite and `make demo` run WITHOUT any of these (fake providers).
# You only need them for `make demo-live` — the real end-to-end proof.

# Provider selection: "fake" (default, deterministic, no network) or "live".
PROVIDER=fake

# SuperDocs — create at use.superdocs.app -> Settings -> API Keys (starts with sk_).
SUPERDOCS_API_KEY=your-superdocs-key-here

# Notion — create a connection at notion.so/my-integrations (Access token, starts with ntn_),
# then share the pages you want to review with the connection.
NOTION_TOKEN=your-notion-token-here

# Note: the Notion page to review is NOT configuration — it is per-request data. Pass it each
# time: `notion-review send --page-id <id>` (in production, a user action / API call / webhook
# supplies it). It deliberately does not live here.

# Postgres (compose sets this automatically inside the container).
DATABASE_URL=postgresql://review:review@localhost:5433/review

# Logging: "json" (structured, default) or "console".
LOG_FORMAT=json

# --- Starting a review from inside Notion ---
# Nothing to set. Every "Review requests" database shared with the integration is found and
# served, so a team is added by sharing their board in Notion — the same gesture that grants
# access — and removed by unsharing it. Run
#   notion-review init-requests --parent-page-id <a page shared with the integration>
# once to create the first board, then add a Notion Button on any page you want reviewable
# (Add page to -> Review requests, Page URL = that page, Status = Requested).
#
# Set this ONLY to pin one deployment to exactly one board in a workspace holding several.
# Leave it empty to serve every board that is shared.
NOTION_REQUESTS_DB=

# --- How the document reaches reviewers (optional) ---
# Default ("notion"): the document is attached to the request row and reviewers drop their
# marked-up copies back onto the same row, so nobody leaves Notion. Set HANDOFF=folder to use
# watched directories instead — real when they sync to a shared Drive, Dropbox or SharePoint
# folder the reviewers already use.
HANDOFF=notion
