# Normalise line endings and check out LF everywhere. Without this, a Windows
# clone gets CRLF and `npm run format:check` fails on a tree that is byte-correct
# in git.
* text=auto eol=lf

# Machine-generated. Collapsed in pull request diffs and excluded from language
# statistics so the review surface is the code that was actually written, not a
# lockfile. Both are still committed, still readable, still diffable on demand.
package-lock.json linguist-generated=true
bench/results.json linguist-generated=true

# Generated by `npm run bench`; the generator owns its formatting.
bench/RESULTS.md -diff
