# TokenScope talks to the live SuperDocs API. There is no offline mock: without a
# key the app starts, explains that the key is missing, and refuses to rewrite.
#
# Copy this file to .env.local (git-ignored) and fill in your key.
#   cp .env.example .env.local

# Your SuperDocs API key. Starts with sk_ or lce_.
# Get one at https://use.superdocs.app -> Settings -> API keys.
SUPERDOCS_API_KEY=

# API root. Override only to point at a different SuperDocs deployment.
SUPERDOCS_BASE_URL=https://api.superdocs.app/v1

# Model tier used for both the surgical rewrite and the whole-document
# counterfactual. Both sides must use the same tier or the comparison is
# meaningless. core | turbo | pro | max
SUPERDOCS_MODEL_TIER=core

# Port for the TokenScope server (holds the API key; the browser never sees it).
PORT=8787
