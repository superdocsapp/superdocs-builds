{
  "name": "tokenscope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SuperDocs selection rewrite with a measured token counter.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:server\" \"vite --host 127.0.0.1\"",
    "server": "tsx --env-file-if-exists=.env.local server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && npm run server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "bench": "tsx --env-file-if-exists=.env.local bench/run.ts",
    "word:certs": "office-addin-dev-certs install --machine",
    "word:validate": "office-addin-manifest validate manifest.xml",
    "word:start": "office-addin-debugging start manifest.xml desktop",
    "word:stop": "office-addin-debugging stop manifest.xml"
  },
  "dependencies": {
    "express": "^5.1.0",
    "gpt-tokenizer": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/office-js": "^1.0.512",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "jsdom": "^29.1.1",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-manifest": "^2.1.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^6.3.6",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
