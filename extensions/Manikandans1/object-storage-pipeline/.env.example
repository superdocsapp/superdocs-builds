# S3-compatible credentials — standard AWS_* names, read by boto3 directly.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

S3_BUCKET=vendor-docs
S3_INCOMING_PREFIX=incoming/
S3_PROCESSED_PREFIX=processed/
S3_FAILED_PREFIX=failed/
# Set for MinIO/LocalStack. Leave unset (comment out) for real AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
PRESIGNED_URL_TTL_SECONDS=900

# --- SuperDocs -----------------------------------------------------------
# Base URL with NO /v1 suffix — the client builds full paths itself
# (e.g. https://api.superdocs.app/v1/documents/upload).
SUPERDOCS_BASE_URL=https://api.superdocs.app
SUPERDOCS_API_KEY=
SUPERDOCS_EDIT_INSTRUCTION=Reformat this document to a clean, consistently styled version with corrected heading hierarchy. Preserve every fact and figure exactly as written; only change formatting and structure.
SUPERDOCS_EXPORT_FORMAT=pdf
# Optional — leave blank to use the API's default tier/depth.
SUPERDOCS_MODEL_TIER=
SUPERDOCS_THINKING_DEPTH=

# "ask_every_time" (default) exercises the full documented four-endpoint
# contract (upload, chat/async, approve, export) with every change
# auto-approved by the pipeline. "approve_all" folds edit+approve into
# one synchronous /v1/chat call — fewer round trips, same end result.
# See extensions/object-storage-pipeline/README.md for the full reasoning.
SUPERDOCS_APPROVAL_MODE=ask_every_time

# Files at/above this size use the pre-signed /v1/uploads flow instead of
# a direct multipart POST to /v1/documents/upload (docs.superdocs.app
# document direct-multipart uploads are reliable only up to ~20 MB).
SUPERDOCS_DIRECT_UPLOAD_MAX_BYTES=15000000
# Logged assumption — see app/config.py docstring for why this isn't a
# value taken verbatim from the docs.
SUPERDOCS_UPLOAD_PURPOSE=document-upload

SUPERDOCS_POLL_INTERVAL_SECONDS=2.0
SUPERDOCS_MAX_WAIT_SECONDS=600.0
SUPERDOCS_MAX_RETRIES=5
SUPERDOCS_RETRY_BASE_DELAY_SECONDS=1.0
SUPERDOCS_REQUEST_TIMEOUT_SECONDS=120.0

STREAM_CHUNK_SIZE_BYTES=262144
POLL_INTERVAL_SECONDS=5.0

# "Budget your operations" — leave blank/unset for unbounded (production)
# behaviour, or set to a small number (e.g. 2) while testing against a
# live free-tier key so a stray watch loop can't burn your whole quota.
MAX_FILES_PER_RUN=
