    "cli-highlight": "^2.1.11",
    "conf": "^12.0.0",
    "diff": "^5.2.0",
    "eventsource": "^2.0.2",
    "form-data": "^4.0.1",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
