# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required. Created at use.superdocs.app under Settings > API Keys.
SUPERDOCS_API_KEY=your-key-here

# Optional. Defaults to the public API.
# SUPERDOCS_BASE_URL=https://api.superdocs.app

# Optional. Without a judge, threads with more than one participant are
# reported as unclear and go to a person instead of being drafted. With one,
# they are reported as contested or actionable depending on what was said.
# Key from aistudio.google.com/apikey. Free tier, no card.
# JUDGE_PROVIDER=gemini
# JUDGE_API_KEY=your-key-here
# JUDGE_MODEL=gemini-3.5-flash-lite
