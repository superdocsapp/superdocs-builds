# SuperDocs API key. Either set this, or run the agent signup flow and let the
# client read ~/.superdocs/agent_credentials.json:
#   curl -X POST https://api.superdocs.app/v1/agents/signup \
#     -H "Content-Type: application/json" \
#     -d '{"terms_accepted": true, "agent_name": "your-name"}'
SUPERDOCS_API_KEY=sk_your_key_here

# Where manifests and exports are written.
NARRATIVE_STORE=./data/reports

# Shared secret the Apps Script add-on sends as X-Addon-Token.
# Leave unset for local development; required for any deployment.
NARRATIVE_ADDON_TOKEN=
